# =============================================================================
# SPEC BRIDGE — Environment Variables
# =============================================================================
# Copy this file to .env and fill in your values:
#   cp .env.example .env
#
# For LOCAL development with Docker Compose + LocalStack:
#   Most values below are pre-configured. You only need to set Bedrock
#   credentials if you want AI features (requirement extraction, tech design).
#   DynamoDB, S3, and Secrets Manager run locally via LocalStack.
#
# For AWS deployment:
#   Fill in all values from your deployed CloudFormation stack outputs.
# =============================================================================

# -- AWS General --------------------------------------------------------------
AWS_REGION=us-east-1

# -- Local development only (LocalStack) -------------------------------------
# Set this to point boto3 at LocalStack. Remove for real AWS.
AWS_ENDPOINT_URL=http://localhost:4566
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test

# -- S3 (Document Storage + KB Data Source) ------------------------------------
S3_BUCKET_NAME=spec-bridge-documents
S3_SSE_TYPE=AES256
S3_KMS_KEY_ID=

# -- DynamoDB (Project & Job State) -------------------------------------------
DYNAMODB_JOBS_TABLE_NAME=spec-bridge-jobs
DYNAMODB_PROJECTS_TABLE_NAME=spec-bridge-projects

# -- AWS Bedrock (AI Models) --------------------------------------------------
# These require REAL AWS credentials with Bedrock access.
# For local dev without AI, leave as-is — API/status endpoints still work.
BEDROCK_CLAUDE_MODEL_ID=anthropic.claude-3-5-sonnet-20241022-v2:0

# -- Bedrock Knowledge Base (Cross-Document RAG) ------------------------------
# Only needed for multi-document projects. Leave empty for single-doc mode.
BEDROCK_KB_ID=
BEDROCK_KB_DATA_SOURCE_ID=

# -- Step Functions (Pipeline Orchestration) -----------------------------------
# Only needed for full pipeline execution. Leave empty for local dev.
STATE_MACHINE_ARN=

# -- Secrets Manager -----------------------------------------------------------
SECRET_NAME=spec-bridge/credentials

# -- Frontend (Next.js) -------------------------------------------------------
NEXT_PUBLIC_API_URL=http://localhost:8000
